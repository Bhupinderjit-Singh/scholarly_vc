# Scholarly environment variables
#
# Copy to `.env` for local development and fill in real values. Never commit
# `.env`. In production, secrets live only in Vercel (web) and Modal (worker)
# environment settings. Only `NEXT_PUBLIC_*` variables reach the browser.
# The full table with purposes and defaults is in `.kiro/steering/tech.md`.

# --- Database (Neon Postgres, pooled connection string) ---------------------
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Separate database used by `npm run test:api`; tables are truncated between tests.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/scholarly_test

# --- Auth (Better Auth) ------------------------------------------------------
# At least 16 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me

# --- Video (LiveKit Cloud or self-hosted; only these three are ever used) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me

# --- Object storage (Cloudflare R2 via the S3 API; required in Phase 2) ------
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=scholarly-recordings

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=re_change-me
EMAIL_FROM=Scholarly <no-reply@example.com>
# `resend` (default) or `capture`. `capture` writes emails to the database
# instead of sending them and is honored only together with E2E_TEST_MODE=true.
EMAIL_TRANSPORT=resend

# --- Web Push (VAPID) --------------------------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:you@example.com

# --- Scheduler ---------------------------------------------------------------
# Bearer secret for POST /api/cron/dispatch, called every 5 minutes by the worker.
CRON_SECRET=change-me

# --- Analysis worker (Modal; required in Phase 2) ----------------------------
WORKER_TRIGGER_URL=https://your-workspace--scholarly-worker.modal.run/analyze
# HMAC-SHA256 secret shared with the worker for trigger and callback signing.
WORKER_SHARED_SECRET=change-me

# --- Access control and caps -------------------------------------------------
# Comma-separated emails that see the Admin page. Empty by default.
ADMIN_EMAILS=
# Set to false to close sign-up (existing accounts can still sign in).
REGISTRATION_OPEN=true
# Video participant-minutes per month, per user and for everyone.
MONTHLY_MINUTES_PER_USER=1500
MONTHLY_MINUTES_GLOBAL=4500
# Focus-analysis hours per month, per user and for everyone (Phase 2).
ANALYSIS_HOURS_PER_USER=60
ANALYSIS_HOURS_GLOBAL=400

# --- Public -------------------------------------------------------------------
# Base URL used in links (emails, calendar feeds, OAuth callbacks).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Test-only ----------------------------------------------------------------
# Enables test helpers such as GET /api/test/outbox. Never set in production.
E2E_TEST_MODE=false
